FROM python:3.12-slim

ENV COLORIAGE_ENGINE_HOST=0.0.0.0
ENV COLORIAGE_ENGINE_PORT=8765
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1
ENV U2NET_HOME=/models/rembg

RUN apt-get update \
  && apt-get install -y --no-install-recommends libgomp1 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install --upgrade pip \
  && python -m pip install -e ".[ai]"

RUN useradd --create-home --shell /usr/sbin/nologin coloriage \
  && mkdir -p /models/rembg \
  && chown -R coloriage:coloriage /models /app

USER coloriage
EXPOSE 8765
CMD ["python", "-m", "coloriage_lot3.server"]

